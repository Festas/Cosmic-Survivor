{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["js/core/**/*", "js/render/**/*", "js/entities/**/*", "js/systems/**/*", "ambient.d.ts"],
  "exclude": ["node_modules", "dist", "tests/**/*", "tools/**/*", "server/**/*", "main.js", "js/entities/player.ts"]
}
